#!/bin/sh
# Generic template. On Termux use its absolute sh path as the shebang.
# Configure these paths for the reviewed release and unprivileged account.
# Keep an existing log/run and its log directory unchanged during migration.
set -eu
umask 077
exec 2>&1
export CTL_HOST=127.0.0.1
export CTL_PORT=18081
export CTL_CONFIG_FILE="${HOME}/.config/http-ctl/server.json"
RELEASE="${HOME}/.local/share/http-ctl/release"
cd "$RELEASE"
exec "$RELEASE/.venv/bin/python" -m http_ctl.server
