#!/usr/bin/env bash
# ctl — client for an http-ctl server.
#
# Environment:
#   CTL_BASE_URL   public HTTPS hostname of the server, e.g.
#                  https://ctl.example.com (no trailing slash)
#   CTL_TOKEN_FILE token file, default ~/.config/http-ctl/token
#
# Usage:
#   ctl health
#   ctl exec "shell command" [timeout_seconds]
#   ctl screenshot [outfile.png]        (default: screenshot.png)
#   ctl download /remote/path [local]   (default: basename in cwd)
#   ctl upload /local/path /remote/path
#
# The token file is read at runtime and never embedded in this script,
# so the script itself is safe to share or commit.

set -u

BASE="${CTL_BASE_URL:?set CTL_BASE_URL, e.g. https://ctl.example.com}"
TOKEN_FILE="${CTL_TOKEN_FILE:-$HOME/.config/http-ctl/token}"
if [ ! -r "$TOKEN_FILE" ]; then
    echo "ctl: cannot read token file: $TOKEN_FILE" >&2
    exit 1
fi
TOKEN="$(cat "$TOKEN_FILE")"
if [ -z "$TOKEN" ]; then
    echo "ctl: token file is empty: $TOKEN_FILE" >&2
    exit 1
fi

auth=(-H "Authorization: Bearer $TOKEN")
cmd="${1:-}"

case "$cmd" in
health)
    curl -sS --fail-with-body "${auth[@]}" "$BASE/health"
    echo
    ;;
exec)
    if [ $# -lt 2 ]; then
        echo "usage: ctl exec \"command\" [timeout]" >&2
        exit 1
    fi
    payload="$(python3 - "$2" "${3:-60}" <<'EOF'
import json, sys
print(json.dumps({"cmd": sys.argv[1], "timeout": int(sys.argv[2])}))
EOF
)"
    curl -sS --fail-with-body "${auth[@]}" \
        -H "Content-Type: application/json" \
        --data "$payload" "$BASE/exec"
    echo
    ;;
screenshot)
    out="${2:-screenshot.png}"
    if curl -sS --fail-with-body "${auth[@]}" -o "$out" "$BASE/screenshot"; then
        echo "saved $out ($(wc -c < "$out") bytes)"
    else
        rm -f "$out"
        exit 1
    fi
    ;;
download)
    if [ $# -lt 2 ]; then
        echo "usage: ctl download /remote/path [local]" >&2
        exit 1
    fi
    out="${3:-$(basename "$2")}"
    # --get keeps this a GET with path in the query string; without it,
    # --data-urlencode would turn it into a POST and the server 404s.
    if curl -sS --fail-with-body "${auth[@]}" \
        --get --data-urlencode "path=$2" -o "$out" "$BASE/download"; then
        echo "saved $out ($(wc -c < "$out") bytes)"
    else
        rm -f "$out"
        exit 1
    fi
    ;;
upload)
    if [ $# -lt 3 ]; then
        echo "usage: ctl upload /local/path /remote/path" >&2
        exit 1
    fi
    # path goes in the query string (URL-encoded); the file is the body.
    qpath="$(python3 -c 'import urllib.parse, sys; print(urllib.parse.quote(sys.argv[1]))' "$3")"
    curl -sS --fail-with-body "${auth[@]}" \
        --data-binary "@$2" "$BASE/upload?path=$qpath"
    echo
    ;;
*)
    echo "usage: ctl {health|exec|screenshot|download|upload}" >&2
    exit 1
    ;;
esac
